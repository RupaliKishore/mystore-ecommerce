# ============================================
# MyStore Environment Variables Template
# ============================================
# Copy this file to '.env' and fill your actual values

# Database (XAMPP default = blank)
DB_PASSWORD=

# Bootstrap Admin (12+ chars, mixed case, symbols)
ADMIN_PASSWORD=ChangeMe@1234

# Gmail App Password (from https://myaccount.google.com/apppasswords)
MAIL_PASSWORD=your_gmail_app_password_here

# JWT Secret (64+ characters, random)
JWT_SECRET=YourJWTSecretKeyAtLeast64CharactersLongRandomStringHere!