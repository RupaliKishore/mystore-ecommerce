# ============================================
# MyStore — Environment Variables Template
# ============================================
# Copy this to '.env' and fill actual values.
# NEVER commit the '.env' file.

# ============ DATABASE (MySQL) ============
# LOCAL (XAMPP): host=localhost, port=3306, user=root, password=(blank)
# PROD (Railway/Aiven): fill their values
DB_HOST=localhost
DB_PORT=3306
DB_NAME=myshop
DB_USERNAME=root
DB_PASSWORD=

# ============ JWT (64+ random chars) ============
JWT_SECRET=YourJWTSecretKeyAtLeast64CharactersLongRandomStringHereGenerateSomethingSecure!

# ============ Bootstrap Admin ============
BOOTSTRAP_ADMIN_ENABLED=false
ADMIN_EMAIL=rupalikishore3011@gmail.com
ADMIN_PASSWORD=ChangeMe@1234

# ============ Mail (Brevo SMTP) ============
BREVO_SMTP_USERNAME=your_brevo_username@smtp-brevo.com
BREVO_SMTP_KEY=your_brevo_smtp_key
MAIL_FROM=rupalikishore3011@gmail.com

# ============ Frontend URL ============
FRONTEND_URL=http://localhost:8081

# ============ Server ============
PORT=8085